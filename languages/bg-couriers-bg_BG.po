#: includes/Admin/class-bgcouriers-settings-admin.php:77
#: includes/Admin/class-bgcouriers-wc-settings.php:20
#: includes/Checkout/class-bgcouriers-checkout.php:1093
#: includes/Checkout/class-bgcouriers-thankyou.php:95
