#. Plugin Name of the plugin
#: bg-couriers.php
msgid "BG Couriers for WooCommerce"
msgstr ""

#. Description of the plugin
#: bg-couriers.php
msgid ""
"Shipping with Bulgarian couriers (Speedy, Econt, BOX NOW, Pigeon, Sameday) -"
" office/address/locker delivery, live rates, labels and tracking."
msgstr ""
"Доставка с български куриери (Speedy, Econt, BOX NOW, Pigeon, Sameday) - "
"доставка до офис/адрес/автомат, живи цени, етикети и проследяване."

#. Author of the plugin
#: bg-couriers.php
msgid "Дан Горяйнов"
msgstr ""

