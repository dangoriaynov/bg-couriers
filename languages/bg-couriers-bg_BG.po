msgid "Username"
msgstr "Потребител"

#: includes/Admin/class-bgc-wc-settings.php:586
msgid "Sameday API username (X-Auth-Username)."
msgstr "Потребител за Sameday API (X-Auth-Username)."

#: includes/Admin/class-bgc-wc-settings.php:588
msgid "Password"
msgstr "Парола"

#: includes/Admin/class-bgc-wc-settings.php:592
msgid ""
"On = the live Sameday account. Off = the demo/test API (sameday-"
"api.demo.zitec.com)."
msgstr ""
"Включено = реалният акаунт на Sameday. Изключено = демо/тестовия API "
