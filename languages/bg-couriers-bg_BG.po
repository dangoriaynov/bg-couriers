#: includes/Admin/class-bgc-wc-settings.php:506
#: includes/Admin/class-bgc-wc-settings.php:556
#: includes/Admin/class-bgc-wc-settings.php:596
#: includes/Admin/class-bgc-wc-settings.php:640
msgid "Delivery & label"
msgstr "Доставка и етикет"

#: includes/Admin/class-bgc-wc-settings.php:448
#: includes/Admin/class-bgc-wc-settings.php:600
msgid "Label paper size"
msgstr "Размер на хартията за етикет"

#: includes/Admin/class-bgc-wc-settings.php:449
#: includes/Admin/class-bgc-wc-settings.php:601
msgid "A4 (office printer)"
msgstr "A4 (офис принтер)"

#: includes/Admin/class-bgc-wc-settings.php:449
#: includes/Admin/class-bgc-wc-settings.php:601
msgid "A6 (label printer)"
msgstr "A6 (етикетен принтер)"

#: includes/Admin/class-bgc-wc-settings.php:451
