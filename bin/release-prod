#!/usr/bin/env bash
# Deploy the current commit to the live shop, prove it landed, then publish to WordPress.org.
# Order is fixed: preflight, BACKUP, deploy, verify, purge, smoke; nothing before the backup touches the site.
#
# Usage: bin/release-prod            (asks once, then runs; asks again before the directory)
#        bin/release-prod --yes      (no prompts - for when it is already agreed)
#        bin/release-prod --detach   (--yes, in a session of its own, logging to tmp/release-<version>.log:
#                                    a release that outlives the terminal that started it)
set -euo pipefail
cd "$(dirname "$0")/.."
VERSION="$(grep -m1 '^ \* Version:' bg-couriers.php | awk '{print $3}')"

# setsid() so a release outlives the terminal that started it; python3 because macOS ships no setsid.
if [ "${1:-}" = "--detach" ]; then
  mkdir -p tmp; LOG="tmp/release-${VERSION}.log"
  nohup python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    bash "$0" --yes > "$LOG" 2>&1 < /dev/null &
  echo "release ${VERSION} is running on its own; follow it with: tail -f ${LOG}"
  echo "when it ends, bin/release-status says where everything stands"
  exit 0
fi
. bin/deploy.conf
: "${BGC_SSH_HOST:?set BGC_SSH_HOST in bin/deploy.conf}"
: "${BGC_SSH_PORT:=22}"
: "${BGC_PROD_PATH:?set BGC_PROD_PATH in bin/deploy.conf}"
# Shop-specific values live only in bin/deploy.conf (gitignored); no smoke list, no release.
: "${BGC_PROD_SMOKE_URLS:?set BGC_PROD_SMOKE_URLS in bin/deploy.conf (space-separated URLs that must answer 200)}"

P="${BGC_PROD_PATH%/}"
WPROOT="$(dirname "$(dirname "$(dirname "$P")")")"   # .../wp-content/plugins/bg-couriers -> the WP root
# The PHP/wp-cli pair is the host's: set BGC_WP_BIN (a container has plain `wp` on the PATH).
WPCLI="${BGC_WP_BIN:-/opt/alt/php-fpm83/usr/bin/php /usr/local/bin/wp}"
WP="$WPCLI --allow-root --path=${WPROOT}"
# Unbound wp-cli: Plugin Check below runs against DEV.
WP_ANY="$WPCLI --allow-root"
# Filters the host's manpath warning from stderr; stderr and the exit code otherwise survive.
run() {
  local err rc; err="$(mktemp)"
  # Prod is an LXC container without our SSH key: go through its host with `lxc exec`.
  if [ -n "${BGC_LXC_HOST:-}" ] && [ -n "${BGC_LXC_PROD:-}" ]; then
    ssh -o ConnectTimeout=25 -p "${BGC_LXC_PORT:-22}" "$BGC_LXC_HOST" "lxc exec ${BGC_LXC_PROD} -- bash -lc $(printf '%q' "$*")" 2>"$err"; rc=$?
  else
    ssh -p "$BGC_SSH_PORT" "$BGC_SSH_HOST" "$@" 2>"$err"; rc=$?
  fi
  grep -v 'manpath: ' "$err" >&2 || true
  rm -f "$err"; return $rc
}
# DEV is a different machine from prod, not just a different --path.
run_dev() {
  if [ -n "${BGC_LXC_HOST:-}" ] && [ -n "${BGC_LXC_DEV:-}" ]; then
    ssh -o ConnectTimeout=25 -p "${BGC_LXC_DEV_PORT:-${BGC_LXC_PORT:-22}}" "${BGC_LXC_DEV_HOST:-$BGC_LXC_HOST}" "lxc exec ${BGC_LXC_DEV} -- bash -lc $(printf '%q' "$*")" 2>/dev/null
    return
  fi
  ssh -p "${BGC_SSH_PORT:-22}" "$BGC_SSH_HOST" "$@" 2>/dev/null
}
bash bin/preflight

# A version published on WordPress.org is spent: bump instead (--republish re-deploys it unchanged).
if svn ls --non-interactive "https://plugins.svn.wordpress.org/bg-couriers/tags/${VERSION}" >/dev/null 2>&1; then
  if [ "${2:-}" != "--republish" ] && [ "${1:-}" != "--republish" ]; then
    echo "REFUSING: ${VERSION} is already published on WordPress.org." >&2
    echo "  Deploying different code under a published number makes prod and the directory disagree." >&2
    echo "  Bump the version and add a changelog entry, or pass --republish to re-deploy it unchanged." >&2
    exit 1
  fi
  echo "  ${VERSION} is published; re-deploying it unchanged (--republish)"
fi

# What the shop runs now (names the backup); a version with no WordPress.org tag is an unfinished release.
WAS="$(run "$WP plugin get bg-couriers --field=version" 2>/dev/null | tr -d '\r' || echo unknown)"
[ -n "$WAS" ] || WAS=unknown
if [ "$WAS" != unknown ] && [ "$WAS" != "$VERSION" ] \
   && ! svn ls --non-interactive "https://plugins.svn.wordpress.org/bg-couriers/tags/${WAS}" >/dev/null 2>&1; then
  echo "  NOTE: prod runs ${WAS} and WordPress.org has no tags/${WAS} - that release never finished."
  echo "        This one supersedes it: the directory goes from what it serves now straight to ${VERSION}."
fi

# Plugin Check BEFORE prod is touched, against DEV (which must run this exact build).
DEVROOT="$(dirname "$(dirname "$(dirname "${BGC_DEV_PATH%/}")")")"
DEV_V="$(run_dev "$WP_ANY --path=${DEVROOT} plugin get bg-couriers --field=version" | tr -d '\r' || true)"
if [ "$DEV_V" != "$VERSION" ]; then
  echo "REFUSING: dev is on ${DEV_V}; deploy this build to dev first (bin/deploy.sh dev)" >&2
  exit 1
fi
CHECK="$(run_dev "$WP_ANY --path=${DEVROOT} plugin check bg-couriers 2>&1 | tail -3" || true)"
echo "$CHECK" | sed 's/^/  /'
echo "$CHECK" | grep -q "No errors found" || { echo "REFUSING: Plugin Check reported errors - prod NOT touched" >&2; exit 1; }

if [ "${1:-}" != "--yes" ]; then
  read -r -p "Deploy ${VERSION} to PROD (${BGC_SSH_HOST})? type yes: " c
  [ "$c" = yes ] || { echo "stopped"; exit 1; }
fi

echo "==> backup"
# Named for the version being REPLACED, timestamped, so a re-run never overwrites the rollback point.
BACKUP="$(dirname "$WPROOT")/bg-couriers-backup-${WAS}-$(date +%Y%m%d-%H%M).tgz"
echo "  replacing ${WAS} with ${VERSION}"
run "cd \"\$(dirname '$P')\" && tar czf '$BACKUP' bg-couriers && du -h '$BACKUP'"

echo "==> deploy"
echo yes | bash bin/deploy.sh prod >/dev/null
[ -n "${BGC_PROD_OWNER:-}" ] && run "chown -R ${BGC_PROD_OWNER} '$P'"

echo "==> verify"
LIVE="$(run "$WP plugin get bg-couriers --field=version" 2>/dev/null | tr -d '\r')"
if [ "$LIVE" != "$VERSION" ]; then
  echo "REFUSING TO CONTINUE: prod reports ${LIVE}, expected ${VERSION}" >&2
  echo "restore with: ssh ... 'cd \$(dirname $P) && rm -rf bg-couriers && tar xzf $BACKUP'" >&2
  exit 1
fi
echo "  prod is running ${LIVE}"
# Nothing that is not the plugin.
STRAY="$(run "ls -d '$P/test-results' '$P/e2e' '$P/tests' 2>/dev/null" || true)"
[ -z "$STRAY" ] && echo "  no test leftovers on the server" || { echo "  STRAY ON PROD: $STRAY" >&2; exit 1; }

echo "==> cache"
# wp-cli has no 'rocket' command on this host; the plugin's own functions do the job.
run "$WP eval 'if(function_exists(\"rocket_clean_domain\")){rocket_clean_domain();rocket_clean_minify();echo \"WP Rocket purged\";}else{echo \"no WP Rocket\";} echo PHP_EOL;'"
run "$WP cache flush" >/dev/null 2>&1 || true

echo "==> smoke"
fail=0
for u in $BGC_PROD_SMOKE_URLS; do
  code="$(curl -s -o /dev/null -w '%{http_code}' -L "$u")"
  printf '  %-38s %s\n' "$u" "$code"
  [ "$code" = 200 ] || fail=1
done

# Every courier must stay exactly as configured.
echo "==> couriers"
run "$WP eval '
foreach (array_keys(BGCouriers_Couriers::all()) as \$c) {
  printf(\"  %-8s enabled=%-4s creds=%s\n\", \$c, get_option(\"bgcouriers_{\$c}_enabled\",\"no\"),
    BGCouriers_Settings::creds_present(\$c) ? \"yes\" : \"no\");
}'"

echo
[ "$fail" -eq 0 ] || { echo "SMOKE FAILED - a page did not return 200. Backup: $BACKUP" >&2; exit 1; }
echo "PROD is on ${VERSION} ($(git rev-parse --short HEAD)). Backup: ${BACKUP}"

# Then the directory, in the same process; preflight already passed on this commit.
if svn ls --non-interactive "https://plugins.svn.wordpress.org/bg-couriers/tags/${VERSION}" >/dev/null 2>&1; then
  echo "tags/${VERSION} is already on WordPress.org - nothing left to publish"
  exit 0
fi
echo
echo "==> WordPress.org"
YES=""; [ "${1:-}" = "--yes" ] && YES="--yes"
BGC_PREFLIGHT_OK="$(git rev-parse HEAD)" exec bash bin/release-wporg $YES
