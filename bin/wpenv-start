#!/usr/bin/env bash
# Start wp-env, surviving Docker Hub's per-IP rate limit on anonymous pulls (shared CI runners):
# pull the images first with backoff, then retry the start.
#
#   bin/wpenv-start                 # pull what wp-env needs, then start it
#   BGC_WPENV_TRIES=2 bin/wpenv-start
#   BGC_WPENV_IMAGES="mariadb:lts" bin/wpenv-start
set -u

IMAGES="${BGC_WPENV_IMAGES:-mariadb:lts phpmyadmin wordpress wordpress:cli}"
TRIES="${BGC_WPENV_TRIES:-5}"
# Doubling from a minute: 1 + 2 + 4 + 8 = 15 minutes before giving up.
BASE_WAIT="${BGC_WPENV_WAIT:-60}"

say()  { printf '%s\n' "$*"; }
warn() { printf '::warning::%s\n' "$*"; }

# A refused pull of an image already present is fine: wp-env only needs it present.
pull() {
  local image="$1" i=1 wait=$BASE_WAIT
  while :; do
    if docker pull --quiet "$image" >/dev/null 2>&1; then
      say "  $image ok"
      return 0
    fi
    if docker image inspect "$image" >/dev/null 2>&1; then
      say "  $image already here (pull refused, the local copy will do)"
      return 0
    fi
    if [ "$i" -ge "$TRIES" ]; then
      warn "could not pull $image after $TRIES tries"
      return 1
    fi
    warn "could not pull $image (try $i of $TRIES), waiting ${wait}s"
    sleep "$wait"
    i=$((i + 1)); wait=$((wait * 2))
  done
}

say "warming the images wp-env needs:"
missing=0
for image in $IMAGES; do
  pull "$image" || missing=1
done
[ "$missing" -eq 0 ] || warn "some images are missing; starting anyway, wp-env will say if it minds"

i=1
while :; do
  if npx --yes @wordpress/env start; then
    exit 0
  fi
  if [ "$i" -ge 3 ]; then
    printf '::error::%s\n' "wp-env would not start after 3 tries - if the log says toomanyrequests, that is Docker Hub's anonymous quota on this runner, not this build: re-run the job"
    exit 1
  fi
  warn "wp-env did not start (try $i of 3), stopping what is up and trying again"
  npx @wordpress/env stop >/dev/null 2>&1 || true
  sleep "$BASE_WAIT"
  i=$((i + 1))
done
