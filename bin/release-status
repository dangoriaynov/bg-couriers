#!/usr/bin/env bash
# Where every copy of the plugin stands, side by side - this checkout, dev, prod, WordPress.org - and
# whether they agree. Read-only and SSH-free: the sites are read over HTTPS through the plugin's own
# readme.txt (every install serves it), the directory through its API and its SVN tags.
#
# Exists because a release CAN stop halfway and nothing said so. 0.4.13 went to the shop on 2026-09-16
# and the bin/release-wporg run that was to follow was killed while it waited on an SSH hop. Prod ran
# 0.4.13, the directory served 0.4.12, and for two days the only way to notice was to compare the two by
# hand - which nobody did until a shop asked why the fix it had read about was not in the update. Now
# bin/deploy.sh dev asks this after every sync and bin/release-prod before it starts, so the gap is
# printed the next time anybody touches a site.
#
# Exit 1 when prod runs a version WordPress.org has no tag for - an unfinished release - so a script can
# ask. Everything else is informational.
#
# Usage: bin/release-status           the table, always
#        bin/release-status --quiet   nothing unless something disagrees
set -uo pipefail
cd "$(dirname "$0")/.."
[ -f bin/deploy.conf ] && . bin/deploy.conf

QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1
SLUG=bg-couriers
LOCAL="$(grep -m1 '^ \* Version:' bg-couriers.php | awk '{print $3}')"

# The sites' public addresses. BGC_DEV_URL / BGC_PROD_URL when set; otherwise the addresses the other
# scripts already know - the Playwright base URL for dev, the first smoke URL for prod.
origin() { printf '%s' "$1" | sed -E 's#^(https?://[^/]+).*#\1#'; }
DEV_URL="${BGC_DEV_URL:-${BGC_E2E_BASE_URL:-}}"
PROD_URL="${BGC_PROD_URL:-$(origin "${BGC_PROD_SMOKE_URLS:-}")}"

# The version a site runs, from the readme it serves. 'unknown' when it cannot be read - a host may
# refuse .txt files - and that is reported as unknown, never as a disagreement.
# Fetched into a variable and parsed after, not piped: `grep -m1` closes the pipe as soon as it has
# its line, curl dies of SIGPIPE, and under pipefail that turned a perfectly good "0.4.13" into
# "0.4.13" followed by "unknown" on every other run.
site_version() {
  [ -n "$1" ] || { echo unknown; return; }
  local body v
  body="$(curl -sS -m 20 -A 'bg-couriers release-status' -L "$(origin "$1")/wp-content/plugins/${SLUG}/readme.txt" 2>/dev/null)"
  v="$(printf '%s\n' "$body" | grep -i '^Stable tag:' | head -1 | awk '{print $3}' | tr -d '\r')"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo "$v" || echo unknown
}
DEV="$(site_version "$DEV_URL")"
PROD="$(site_version "$PROD_URL")"
# What the directory SERVES (its API) and what it HOLDS (the tags) are two different facts: a tag lands
# in seconds and the API follows minutes to an hour later. Both are read, so a fresh commit reads as
# "in, not yet served" rather than as missing.
API="$(curl -sS -m 20 "https://api.wordpress.org/plugins/info/1.0/${SLUG}.json" 2>/dev/null)"
WPORG="$(printf '%s' "$API" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null)"
[[ "$WPORG" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || WPORG=unknown
TAGS="$(svn ls --non-interactive "https://plugins.svn.wordpress.org/${SLUG}/tags/" 2>/dev/null | tr -d '/' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true)"
LATEST_TAG="$(printf '%s\n' "$TAGS" | sort -V | tail -1)"; [ -n "$LATEST_TAG" ] || LATEST_TAG=unknown

problems=()
if [ "$PROD" != unknown ] && [ -n "$TAGS" ] && ! printf '%s\n' "$TAGS" | grep -qx "$PROD"; then
  problems+=("UNFINISHED RELEASE: prod runs ${PROD} and WordPress.org has no tags/${PROD}. Finish it - bin/release-wporg from the ${PROD} release commit - or release the next version, which supersedes it.")
fi
if [ "$WPORG" != unknown ] && [ "$LATEST_TAG" != unknown ] && [ "$WPORG" != "$LATEST_TAG" ]; then
  problems+=("directory: tags/${LATEST_TAG} is in SVN but the API still serves ${WPORG} - it re-indexes on its own time (0.4.12 took over 40 minutes)")
fi

if [ "$QUIET" -eq 0 ] || [ "${#problems[@]}" -gt 0 ]; then
  printf '  %-14s %s\n' 'checkout' "${LOCAL} ($(git rev-parse --short HEAD 2>/dev/null || echo ?))" \
                       'dev' "$DEV" 'prod' "$PROD" 'wp.org serves' "$WPORG" 'wp.org tags' "$LATEST_TAG"
fi
for p in "${problems[@]}"; do printf '  \033[31m!!\033[0m %s\n' "$p"; done
# Only the unfinished release is a failure: it is the one state that is nobody's intention.
case "${problems[0]:-}" in UNFINISHED*) exit 1;; esac
exit 0
