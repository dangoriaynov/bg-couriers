#!/usr/bin/env bash
# Versions of this checkout, dev, prod and WordPress.org side by side; read-only, over HTTPS (readme.txt,
# the plugin API, SVN tags). Exit 1 only for an unfinished release: prod on a version with no tag.
#
# Usage: bin/release-status           the table, always
#        bin/release-status --quiet   nothing unless something disagrees
set -uo pipefail
cd "$(dirname "$0")/.."
[ -f bin/deploy.conf ] && . bin/deploy.conf

QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1
SLUG=bg-couriers
LOCAL="$(grep -m1 '^ \* Version:' bg-couriers.php | awk '{print $3}')"

# BGC_DEV_URL / BGC_PROD_URL, else the Playwright base URL and the first smoke URL.
origin() { printf '%s' "$1" | sed -E 's#^(https?://[^/]+).*#\1#'; }
DEV_URL="${BGC_DEV_URL:-${BGC_E2E_BASE_URL:-}}"
PROD_URL="${BGC_PROD_URL:-$(origin "${BGC_PROD_SMOKE_URLS:-}")}"

# 'unknown' (never a disagreement) when unreadable. Not piped: grep -m1 would SIGPIPE curl under pipefail.
site_version() {
  [ -n "$1" ] || { echo unknown; return; }
  local body v
  body="$(curl -sS -m 20 -A 'bg-couriers release-status' -L "$(origin "$1")/wp-content/plugins/${SLUG}/readme.txt" 2>/dev/null)"
  v="$(printf '%s\n' "$body" | grep -i '^Stable tag:' | head -1 | awk '{print $3}' | tr -d '\r')"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo "$v" || echo unknown
}
DEV="$(site_version "$DEV_URL")"
PROD="$(site_version "$PROD_URL")"
# What the directory SERVES (API) lags what it HOLDS (tags) by up to an hour; both are read.
API="$(curl -sS -m 20 "https://api.wordpress.org/plugins/info/1.0/${SLUG}.json" 2>/dev/null)"
WPORG="$(printf '%s' "$API" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null)"
[[ "$WPORG" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || WPORG=unknown
TAGS="$(svn ls --non-interactive "https://plugins.svn.wordpress.org/${SLUG}/tags/" 2>/dev/null | tr -d '/' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true)"
LATEST_TAG="$(printf '%s\n' "$TAGS" | sort -V | tail -1)"; [ -n "$LATEST_TAG" ] || LATEST_TAG=unknown

problems=()
if [ "$PROD" != unknown ] && [ -n "$TAGS" ] && ! printf '%s\n' "$TAGS" | grep -qx "$PROD"; then
  problems+=("UNFINISHED RELEASE: prod runs ${PROD} and WordPress.org has no tags/${PROD}. Finish it - bin/release-wporg from the ${PROD} release commit - or release the next version, which supersedes it.")
fi
if [ "$WPORG" != unknown ] && [ "$LATEST_TAG" != unknown ] && [ "$WPORG" != "$LATEST_TAG" ]; then
  problems+=("directory: tags/${LATEST_TAG} is in SVN but the API still serves ${WPORG} - it re-indexes on its own time (0.4.12 took over 40 minutes)")
fi

if [ "$QUIET" -eq 0 ] || [ "${#problems[@]}" -gt 0 ]; then
  printf '  %-14s %s\n' 'checkout' "${LOCAL} ($(git rev-parse --short HEAD 2>/dev/null || echo ?))" \
                       'dev' "$DEV" 'prod' "$PROD" 'wp.org serves' "$WPORG" 'wp.org tags' "$LATEST_TAG"
fi
for p in "${problems[@]}"; do printf '  \033[31m!!\033[0m %s\n' "$p"; done
case "${problems[0]:-}" in UNFINISHED*) exit 1;; esac
exit 0
