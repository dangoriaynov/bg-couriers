#!/usr/bin/env bash
# Rebuild languages/bg-couriers.pot from the source, then merge it into the Bulgarian catalogue.
#
# This exists because the keyword list drifted. The template was once built without -k_n_noop, so the
# order status "Shipped (%s)" was never offered for translation and nobody noticed - and a string added
# to the code without a matching template entry is invisible to the completeness check in bin/preflight,
# which only ever looked at what was already IN the .po. One script, one keyword list, every time.
#
#   bin/make-pot            # regenerate the template and merge (new entries are left empty)
#   bin/make-pot --check    # touch nothing; say whether the catalogue still covers the code
#
# Filling the empty Bulgarian entries is a separate, human step. bin/preflight refuses a release while
# any is still empty, and (through --check) while the code has a string the catalogue has never seen.
set -euo pipefail
cd "$(dirname "$0")/.."

POT=languages/bg-couriers.pot
PO=languages/bg-couriers-bg_BG.po
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
OUT="$POT"
[ "$CHECK" = 1 ] && OUT="$TMP/check.pot"

# Bundled third-party libraries (FPDF/FPDI) carry their own English exception text and are not ours to
# translate; tests and the e2e suite are not shipped.
find . -name '*.php' \
  -not -path './vendor/*' -not -path './node_modules/*' -not -path './includes/lib/*' \
  -not -path './tests/*' -not -path './e2e/*' | sed 's|^\./||' | sort > "$TMP/files"

xgettext --from-code=UTF-8 --language=PHP \
  -k__ -k_e -k_x:1,2c -k_ex:1,2c \
  -kesc_html__ -kesc_html_e -kesc_html_x:1,2c \
  -kesc_attr__ -kesc_attr_e -kesc_attr_x:1,2c \
  -k_n:1,2 -k_nx:1,2,4c -k_n_noop:1,2 -k_nx_noop:1,2,3c \
  --add-comments=translators \
  --package-name="BG Couriers for WooCommerce" \
  -o "$OUT" -f "$TMP/files" 2>/dev/null

if [ "$CHECK" = 1 ]; then
  # Every string the code offers for translation must already have an entry in the Bulgarian catalogue.
  # msgcomm prints what is in the template and NOT in the .po; anything here is a string a Bulgarian
  # shop would read in English.
  # --omit-header is deliberately NOT passed: without a header msgcomm has no charset to read the
  # Cyrillic .po with and drowns the run in "invalid multibyte sequence". So the header entry comes
  # through as one msgid of its own, and one is the empty result.
  msgcomm --unique -o "$TMP/missing.po" "$OUT" "$PO"
  N="$(grep -c '^msgid "' "$TMP/missing.po" || true)"
  if [ "$N" -gt 1 ]; then
    echo "$((N - 1)) string(s) in the code have no entry in $PO:" >&2
    grep '^msgid "' "$TMP/missing.po" | grep -v '^msgid ""$' | sed 's/^/  /' >&2
    echo "  Run bin/make-pot, fill the Bulgarian, then msgfmt." >&2
    exit 1
  fi
  echo "the catalogue covers every translatable string in the code"
  exit 0
fi

msgmerge --quiet --backup=none --update "$PO" "$POT"
printf 'template: %s strings\n' "$(grep -c '^msgid ' "$POT")"
printf 'untranslated: %s\n' "$(msgattrib --untranslated "$PO" | grep -c '^msgid "' || true)"
echo "Now fill any empty msgstr in $PO, then: msgfmt -o languages/bg-couriers-bg_BG.mo $PO"
