#!/usr/bin/env bash
# Rebuild languages/bg-couriers.pot from the source (one keyword list), then merge it into the Bulgarian catalogue.
#
#   bin/make-pot            # regenerate the template and merge (new entries are left empty)
#   bin/make-pot --check    # touch nothing; say whether the catalogue still covers the code
# Filling the Bulgarian is a human step; bin/preflight refuses a release while any entry is empty.
set -euo pipefail
cd "$(dirname "$0")/.."

POT=languages/bg-couriers.pot
PO=languages/bg-couriers-bg_BG.po
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
OUT="$POT"
[ "$CHECK" = 1 ] && OUT="$TMP/check.pot"

# Bundled FPDF/FPDI and the test suites are not ours to translate.
find . -name '*.php' \
  -not -path './vendor/*' -not -path './node_modules/*' -not -path './includes/lib/*' \
  -not -path './tests/*' -not -path './e2e/*' | sed 's|^\./||' | sort > "$TMP/files"

xgettext --from-code=UTF-8 --language=PHP \
  -k__ -k_e -k_x:1,2c -k_ex:1,2c \
  -kesc_html__ -kesc_html_e -kesc_html_x:1,2c \
  -kesc_attr__ -kesc_attr_e -kesc_attr_x:1,2c \
  -k_n:1,2 -k_nx:1,2,4c -k_n_noop:1,2 -k_nx_noop:1,2,3c \
  --add-comments=translators \
  --package-name="BG Couriers for WooCommerce" \
  -o "$OUT" -f "$TMP/files" 2>/dev/null

if [ "$CHECK" = 1 ]; then
  # Merge without fuzzy guessing: what comes out untranslated is a code string the catalogue has never seen;
  # strings the code dropped go obsolete and are ignored.
  msgmerge -q --no-fuzzy-matching -o "$TMP/merged.po" "$PO" "$OUT" 2>/dev/null
  msgattrib --untranslated --no-obsolete -o "$TMP/missing.po" "$TMP/merged.po" 2>/dev/null || : > "$TMP/missing.po"
  N="$(grep -c '^msgid "' "$TMP/missing.po" 2>/dev/null || true)"
  # The header counts as one msgid when anything at all is listed; nothing listed is an empty file.
  if [ "${N:-0}" -gt 1 ]; then
    echo "$((N - 1)) string(s) in the code have no entry in $PO:" >&2
    grep '^msgid "' "$TMP/missing.po" | grep -v '^msgid ""$' | sed 's/^/  /' >&2
    echo "  Run bin/make-pot, fill the Bulgarian, then msgfmt." >&2
    exit 1
  fi
  # Nothing may be fuzzy: msgfmt leaves fuzzy entries out of the .mo, so they ship in English.
  msgattrib --only-fuzzy --no-obsolete -o "$TMP/fuzzy.po" "$TMP/merged.po" 2>/dev/null || : > "$TMP/fuzzy.po"
  F="$(grep -c '^msgid "' "$TMP/fuzzy.po" 2>/dev/null || true)"
  if [ "${F:-0}" -gt 1 ]; then
    echo "$((F - 1)) fuzzy string(s) in $PO - guessed, not translated, and left out of the .mo:" >&2
    grep '^msgid "' "$TMP/fuzzy.po" | grep -v '^msgid ""$' | sed 's/^/  /' >&2
    echo "  Check each guess (the placeholders in particular), then remove its '#, fuzzy' line and msgfmt." >&2
    exit 1
  fi
  echo "the catalogue covers every translatable string in the code"
  exit 0
fi

msgmerge --quiet --backup=none --update "$PO" "$POT"
printf 'template: %s strings\n' "$(grep -c '^msgid ' "$POT")"
printf 'untranslated: %s\n' "$(msgattrib --untranslated "$PO" | grep -c '^msgid "' || true)"
FZ="$(msgattrib --only-fuzzy --no-obsolete "$PO" | grep -c '^msgid "' || true)"
if [ "${FZ:-0}" -gt 1 ]; then
  printf 'fuzzy (guessed - check them, then drop the "#, fuzzy" line): %s\n' "$((FZ - 1))"
  msgattrib --only-fuzzy --no-obsolete "$PO" | grep '^msgid "' | grep -v '^msgid ""$' | sed 's/^/  /'
fi
echo "Now fill any empty msgstr in $PO, then:"
echo "  msgfmt -o languages/bg-couriers-bg_BG.mo $PO && bin/make-php"
echo "(bin/make-php writes the .l10n.php form, which WordPress reads BEFORE the .mo since 6.5)"
